# Discord bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID from the same page -> General Information
CLIENT_ID=your-application-id-here

# Optional: a guild (server) ID to register slash commands instantly during dev.
# Leave blank to register globally (takes up to ~1 hour to propagate).
GUILD_ID=

# Your Discord user ID — the only account allowed to run /subscribe and
# /unsubscribe. Enable Developer Mode in Discord, then right-click your name ->
# Copy User ID.
OWNER_ID=your-discord-user-id-here
